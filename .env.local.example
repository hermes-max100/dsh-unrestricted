# ---------------------------------------------------------------------------
# Local credentials. Copy to .env.local and fill in.
# .env.local is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Higgsfield, in key-id:key-secret format (Higgsfield console).
HF_CREDENTIALS=

# Runway API secret (developer portal). NOTE: Runway API credits are a separate
# balance from a runway.com subscription — a consumer plan does not fund these.
RUNWAYML_API_SECRET=

# --- Optional assets for runway.ts -----------------------------------------
# Set to switch h3_max from text-to-video to image-to-video. H3 Max has no
# aspect-ratio parameter, so the output inherits this image's ratio: use a
# 9:16 still for vertical short-form.
RUNWAY_PROMPT_IMAGE=

# Act-Two character performance. The reference video must be 3-30 seconds and
# show a visible face that stays in frame.
RUNWAY_CHARACTER_IMAGE=
RUNWAY_REFERENCE_VIDEO=
